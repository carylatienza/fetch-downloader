# Downloader Service URL (URL of the dedicated Docker container microservice with Python + yt-dlp + FFmpeg)
# Example: https://my-downloader-service.onrender.com or http://localhost:3000
DOWNLOADER_SERVICE_URL=

# Optional Proxy settings for yt-dlp to bypass datacenter IP rate-limiting / bot protection
# Example: http://username:password@proxy.example.com:8080
YTDLP_PROXY=
HTTP_PROXY=
HTTPS_PROXY=

# Optional: override yt-dlp's default extraction client if YouTube starts
# bot-blocking the container's IP (e.g. "Sign in to confirm you're not a bot").
# Example: android,web
YTDLP_PLAYER_CLIENT=
